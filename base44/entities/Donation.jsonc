{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string"
    },
    "donor_email": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "ngo",
        "fundraiser"
      ],
      "default": "ngo"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "held_for_review",
        "released",
        "refunded",
        "flagged"
      ],
      "default": "completed"
    },
    "payment_instrument": {
      "type": "string"
    },
    "donor_ip": {
      "type": "string"
    },
    "device_fingerprint": {
      "type": "string"
    },
    "fraud_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "number",
      "default": 0
    },
    "held_reason": {
      "type": "string"
    }
  },
  "required": [
    "donor_name",
    "recipient_type",
    "recipient_id",
    "recipient_name",
    "amount"
  ]
}